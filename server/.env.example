PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/courseplatform?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
CURRENCY=PKR
# Optional: If your Razorpay test account rejects non-INR currencies, set a fallback charge currency
# RAZORPAY_CHARGE_CURRENCY=INR
# Configurable exchange rate (e.g. 1 PKR = 0.30 INR in test mode). Never hardcoded.
# EXCHANGE_RATE=0.30

# Razorpay Test Credentials (used in Step 8)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# Email Testing (used in Step 13)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=placeholder_user
EMAIL_PASS=placeholder_pass

